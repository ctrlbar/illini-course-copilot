# xAI Grok API key (https://console.x.ai). Without it the app runs in demo mode with rule-based parsing.
XAI_API_KEY=
GROK_MODEL=grok-4

# Term students are registering for
TERM_YEAR=2027
TERM_SEASON=spring

PORT=3000
ALERT_POLL_MINUTES=5

# Optional: email seat alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
